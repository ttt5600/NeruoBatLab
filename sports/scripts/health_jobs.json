{
  "_doc": "Per-job config for scripts/health_monitor.py. $K = ~/.claude/quant-kalshi, $S = ~/.claude/quant-sports. expect: loaded | unloaded (retired on purpose) | idle (loaded, no output expected now). outputs[].max_gap_h = max hours since the file last grew / last row ts while ACTIVE. ts = row timestamp field (ISO or epoch s); keys = fields that must be non-empty in the last rows; where = row filter {field: value or [prefix*]}. picks: rows counted per PT day; zero_days = consecutive ACTIVE days with 0 picks that trip BROKEN. active: season [MM-DD, MM-DD] (wraps), weekdays [0=Mon..6], month_tail N (last N days of month), from / until (ISO). Seasons: NBA 10-20..06-20, NHL 10-05..06-25, NFL 09-04..02-12, CFB 08-23..01-21.",
  "seasons": {
    "nba": ["10-20", "06-20"],
    "nhl": ["10-05", "06-25"],
    "nfl": ["09-04", "02-12"],
    "cfb": ["08-23", "01-21"]
  },
  "jobs": [
    {"job": "kalshi-paper (E4 picks + exec)", "label": "quant-kalshi-paper",
     "logs": ["$K/run.log", "$K/exec.log"], "stderr": ["$K/launchd.err"], "warn_re": "^LOST ",
     "outputs": [{"path": "$K/data/kalshi_paper.jsonl", "max_gap_h": 26, "ts": "logged_at", "keys": ["ticker", "event", "yes_bid", "forecasts"]},
                 {"path": "$K/data/kalshi_exec.jsonl", "max_gap_h": 30, "ts": "ts", "keys": ["event"]}],
     "picks": {"path": "$K/data/kalshi_paper.jsonl", "ts": "logged_at", "zero_days": 1}},
    {"job": "pmus-weather-paper (F4)", "label": "quant-pmus-weather-paper",
     "logs": ["$K/pmus_weather_paper.log"], "stderr": ["$K/pmus_weather_paper.err"],
     "outputs": [{"path": "$K/data/pmus_weather_paper.jsonl", "max_gap_h": 26, "ts": "logged_at", "keys": ["city", "slug", "forecasts"]}],
     "picks": {"path": "$K/data/pmus_weather_paper.jsonl", "ts": "logged_at", "zero_days": 1}},
    {"job": "forecastex-paper (FX1)", "label": "quant-forecastex-paper",
     "logs": ["$K/forecastex_paper.log"], "stderr": ["$K/forecastex_paper.err"],
     "outputs": [{"path": "$K/data/forecastex_paper.jsonl", "max_gap_h": 26, "ts": "ts", "keys": ["ticker", "side", "fc"]}],
     "picks": {"path": "$K/data/forecastex_paper.jsonl", "ts": "ts", "where": {"kind": "pick"}, "zero_days": 1}},
    {"job": "forecastex-exec (E5X live, IBKR)", "label": "quant-forecastex-exec", "expect": "unloaded",
     "note": "user stopped IBKR 2026-11-15 (STATE.md)"},
    {"job": "ibc-gateway (IBKR)", "label": "ibc-gateway", "expect": "unloaded", "note": "user stopped IBKR 2026-11-15"},
    {"job": "fund-brief", "label": "quant-fund-brief",
     "logs": ["$K/fund_brief.log"], "stderr": ["$K/fund_brief.err"],
     "outputs": [{"path": "$K/fund_brief.log", "max_gap_h": 26}]},
    {"job": "gap-logger", "label": "quant-gap-logger",
     "logs": ["$K/gap_logger.log"], "stderr": ["$K/gap_logger.err"],
     "outputs": [{"path": "$K/data/gap_ticks.jsonl", "max_gap_h": 1, "ts": "ts", "keys": ["seen"]},
                 {"path": "$K/data/gap_pin_odds.jsonl", "max_gap_h": 1, "ts": "ts", "keys": ["league"]}]},
    {"job": "kalshi-wx-monthly (L39)", "label": "quant-kalshi-wx-monthly",
     "logs": ["$K/kalshi_wx_monthly.log"], "stderr": ["$K/kalshi_wx_monthly.err"],
     "outputs": [{"path": "$K/kalshi_wx_monthly.log", "max_gap_h": 26, "active": {"month_tail": 6}}]},
    {"job": "lead-exec (TSA/L39/DUL live)", "label": "quant-lead-exec",
     "logs": ["$K/lead_exec.log"], "stderr": ["$K/lead_exec.err"],
     "outputs": [{"path": "$K/data/lead_exec.jsonl", "max_gap_h": 48, "ts": "ts", "keys": ["event", "ticker"]}]},
    {"job": "lip-paper-b (L40b)", "label": "quant-lip-paper-b",
     "logs": ["$K/lip_paper_b.log"], "stderr": ["$K/lip_paper_b.err"],
     "outputs": [{"path": "$K/data/lip_b_ticks.jsonl", "max_gap_h": 1, "ts": "ts", "keys": ["live_programs", "books"]}]},
    {"job": "live-board", "label": "quant-live-board",
     "logs": ["$K/live_board.log"], "stderr": ["$K/live_board.err"],
     "heartbeat": {"path": "$K/live_board.heartbeat", "max_gap_h": 0.25},
     "outputs": [{"path": "$K/data/live_board.jsonl", "max_gap_h": 30, "ts": "ts", "keys": ["sport", "gid", "game"], "active": {"season": "nba"}}]},
    {"job": "live-signals (NFL rain)", "label": "quant-live-signals",
     "logs": ["$K/live_signals.log"], "stderr": ["$K/live_signals.err"],
     "outputs": [{"path": "$K/data/live_signals_eval.jsonl", "max_gap_h": 192, "ts": "ts", "keys": ["signal", "game"], "active": {"season": "nfl"}}]},
    {"job": "nba-midgame", "label": "quant-nba-midgame",
     "logs": ["$K/nba_midgame.log"], "stderr": ["$K/nba_midgame.err"],
     "heartbeat": {"path": "$K/nba_midgame.heartbeat", "max_gap_h": 0.25},
     "outputs": [{"path": "$K/data/nba_midgame_ticks.jsonl", "max_gap_h": 30, "ts": "ts", "keys": ["eid", "game", "period"], "active": {"season": "nba"}}]},
    {"job": "nba-open-totals (Q004-NBA)", "label": "quant-nba-open-totals",
     "logs": ["$K/nba_open_totals.log"], "stderr": ["$K/nba_open_totals.err"],
     "outputs": [{"path": "$K/data/open_totals_picks.jsonl", "max_gap_h": 30, "active": {"season": "nba"}}],
     "picks": {"path": "$K/data/open_totals_picks.jsonl", "ts": "t", "where": {"type": ["pick*"]}, "keys": ["key", "model"], "zero_days": 2, "active": {"season": "nba"}}},
    {"job": "open-lines (L34 NHL / L33 NFL)", "label": "quant-open-lines",
     "logs": ["$K/open_lines.log"], "stderr": ["$K/open_lines.err"],
     "outputs": [{"path": "$K/data/open_lines_nhl_picks.jsonl", "max_gap_h": 30, "active": {"season": "nhl"}},
                 {"path": "$K/data/open_lines_nfl_picks.jsonl", "max_gap_h": 192, "active": {"season": "nfl"}}],
     "picks": {"path": "$K/data/open_lines_nhl_picks.jsonl", "ts": "t", "where": {"type": ["pick*"]}, "keys": ["key", "market", "pick"], "zero_days": 2, "active": {"season": "nhl"}}},
    {"job": "q013 (RT/MC logger)", "label": "quant-q013",
     "logs": ["$K/q013_logger.log"], "stderr": ["$K/q013_logger.err"],
     "outputs": [{"path": "$K/data/q013/snapshots.jsonl", "max_gap_h": 1, "ts": "ts", "keys": ["ticker", "yes_bid", "close_ts"]},
                 {"path": "$K/data/q013/scores.jsonl", "max_gap_h": 2, "ts": "ts", "keys": ["event", "source"]}],
     "picks": {"path": "$K/data/q013/picks.jsonl", "ts": "ts", "keys": ["ticker", "decision", "yes_bid"], "zero_days": 3}},
    {"job": "q014 (Truth Social counts)", "label": "quant-q014",
     "logs": ["$K/q014_logger.log"], "stderr": ["$K/q014_logger.err"],
     "outputs": [{"path": "$K/data/q014/snapshots.jsonl", "max_gap_h": 1, "ts": "ts", "keys": ["ticker", "yes_bid"]},
                 {"path": "$K/data/q014/counts.jsonl", "max_gap_h": 1, "ts": "ts", "keys": ["event", "count"]}],
     "picks": {"path": "$K/data/q014/picks.jsonl", "ts": "ts", "keys": ["ticker", "decision"], "zero_days": 2}},
    {"job": "thesis-tracker", "label": "quant-thesis-tracker",
     "logs": ["$K/thesis_tracker.log"], "stderr": ["$K/thesis_tracker.err"],
     "outputs": [{"path": "$K/data/thesis/tracker_v2.jsonl", "max_gap_h": 80, "ts": "logged_at", "keys": ["date", "v2_all"]}]},
    {"job": "paper-step (quant-paper, other project)", "label": "quant-paper-step", "stderr": ["~/.claude/quant-paper/launchd.err"]},

    {"job": "crypto-barrier (CB1-3)", "label": "quant-sports-crypto-barrier", "qs": "crypto-barrier",
     "heartbeat": {"path": "$S/state/crypto_barrier_heartbeat", "max_gap_h": 0.25},
     "outputs": [{"path": "$S/data/kx_forward/crypto_barrier.jsonl", "max_gap_h": 26, "ts": "finished", "where": {"kind": "day"}, "keys": ["uday", "status", "quotes"]}],
     "picks": {"path": "$S/data/kx_forward/crypto_barrier.jsonl", "ts": "finished", "where": {"kind": "day", "status": "decided"}, "zero_days": 1, "what": "decided days"}},
    {"job": "digest (claude -p, 09:00/23:30)", "label": "quant-sports-digest", "qs": "digest",
     "err_re": "Traceback|\"is_error\": true|\"rc\": [1-9]|syntax error",
     "outputs": [{"glob": "$S/digests/20??-??-??-?m.md", "max_gap_h": 15}]},
    {"job": "e4-0600 (E4 06:00 add-on)", "label": "quant-sports-e4-0600", "qs": "e4-0600",
     "heartbeat": {"path": "$S/state/e4_0600_heartbeat", "max_gap_h": 0.25},
     "outputs": [{"path": "$S/data/kx_forward/e4_0600.jsonl", "max_gap_h": 26, "ts": "ts", "where": {"kind": "city_day"}, "keys": ["city", "event_day", "status"]}],
     "picks": {"path": "$S/data/kx_forward/e4_0600.jsonl", "ts": "ts", "where": {"kind": "city_day"}, "zero_days": 1, "what": "city-day decisions"}},
    {"job": "e4p (E4 rule C / C-agree)", "label": "quant-sports-e4p", "qs": "e4p",
     "heartbeat": {"path": "$S/state/e4p_heartbeat", "max_gap_h": 0.25},
     "outputs": [{"path": "$S/data/kx_forward/e4p.jsonl", "max_gap_h": 26, "ts": "decided_at", "where": {"kind": "city_day"}, "keys": ["series", "event_day", "forecasts"]}],
     "picks": {"path": "$S/data/kx_forward/e4p.jsonl", "ts": "decided_at", "where": {"kind": "bracket"}, "keys": ["ticker", "yes_bid"], "zero_days": 1, "what": "bracket rows"}},
    {"job": "early-form (F1)", "label": "quant-sports-early-form", "qs": "early-form", "expect": "idle",
     "note": "F1 window (<=8 games) closed ~11-07; logger runs but writes nothing by design"},
    {"job": "econ-events", "label": "quant-sports-econ-events", "qs": "econ-events",
     "heartbeat": {"path": "$S/state/econ_events_heartbeat", "max_gap_h": 0.1},
     "warn_re": "MISSED",
     "outputs": [{"path": "$S/data/kx_forward/econ_events/books.jsonl.gz", "max_gap_h": 96, "ts": "ts", "keys": ["event", "ticker", "slot"]},
                 {"path": "$S/data/kx_forward/econ_events/schedule.jsonl.gz", "max_gap_h": 8}]},
    {"job": "esports-pin (ESP1)", "label": "quant-sports-esports-pin", "qs": "esports-pin",
     "heartbeat": {"path": "$S/state/esports_pin_heartbeat", "max_gap_h": 0.1},
     "outputs": [{"path": "$S/data/esports_pin/fetch.jsonl", "max_gap_h": 1, "ts": "ts", "keys": ["n_kal"]}]},
    {"job": "kx-k1 (L32b on Kalshi)", "label": "quant-sports-kx-k1", "qs": "kx-k1",
     "outputs": [{"path": "$S/data/kx_forward/k1.jsonl", "max_gap_h": 30, "ts": "logged_at", "keys": ["trial", "key"], "active": {"season": "nba"}}],
     "picks": {"path": "$S/data/kx_forward/k1.jsonl", "ts": "logged_at", "where": {"kind": "pick"}, "keys": ["key", "pick", "event"], "zero_days": 3, "active": {"season": "nba"}}},
    {"job": "kx-kcfb (K-CFB)", "label": "quant-sports-kx-kcfb", "qs": "kx-kcfb",
     "outputs": [{"path": "$S/data/kx_forward/kcfb.jsonl", "max_gap_h": 30, "active": {"season": "cfb"}}]},
    {"job": "kx-knfl (K-NFL / K50-NFL)", "label": "quant-sports-kx-knfl", "qs": "kx-knfl",
     "outputs": [{"path": "$S/data/kx_forward/k50nfl.jsonl", "max_gap_h": 192, "active": {"season": "nfl"}},
                 {"path": "$S/data/kx_forward/knfl.jsonl", "max_gap_h": 192, "active": {"season": "nfl"}}]},
    {"job": "kx-openers (openers timing)", "label": "quant-sports-kx-openers", "qs": "kx-openers",
     "outputs": [{"path": "$S/results/kalshi_openers_xleague/first_seen_fwd.json", "max_gap_h": 10}]},
    {"job": "l32b (NBA totals)", "label": "quant-sports-l32b", "qs": "l32b",
     "outputs": [{"path": "$S/data/l32b_log.jsonl", "max_gap_h": 30, "ts": "t", "keys": ["key", "type"], "active": {"season": "nba"}}],
     "picks": {"path": "$S/data/l32b_log.jsonl", "ts": "t", "where": {"type": "decision"}, "keys": ["key", "open_line"], "zero_days": 3, "active": {"season": "nba"}}},
    {"job": "lock-queue", "label": "quant-sports-lock-queue", "expect": "unloaded", "note": "retired (ACT_LIST.md: plist kept, unloaded)"},
    {"job": "lx1 (logical-arb scanner)", "label": "quant-sports-lx1", "qs": "lx1",
     "outputs": [{"path": "$S/results/lx1_logical_arb/scans.jsonl", "max_gap_h": 3, "ts": "ts", "keys": ["markets", "events"], "active": {"until": "2026-11-20T08:00:00+00:00"}},
                 {"path": "$S/results/lx1_logical_arb/persistence.csv", "max_gap_h": 26}]},
    {"job": "nfl-fade (F1L live)", "label": "quant-sports-nfl-fade", "qs": "nfl-fade",
     "heartbeat": {"path": "$S/state/nfl_fade_heartbeat", "max_gap_h": 0.1},
     "outputs": [{"path": "$S/data/live/nfl_fade_live.jsonl", "max_gap_h": 192, "active": {"season": "nfl"}}]},
    {"job": "nhl-goalie", "label": "quant-sports-nhl-goalie", "qs": "nhl-goalie",
     "heartbeat": {"path": "$S/state/nhl_goalie_heartbeat", "max_gap_h": 0.1},
     "outputs": [{"path": "$S/data/nhl_goalie/events.jsonl", "max_gap_h": 30, "ts": "first_seen_at", "keys": ["gameId", "goalie"], "active": {"season": "nhl"}}]},
    {"job": "nhl-ingame (NHL paper + exec)", "label": "quant-sports-nhl-ingame", "qs": "nhl-ingame",
     "heartbeat": {"path": "$S/state/nhl_ingame_heartbeat", "max_gap_h": 0.1},
     "outputs": [{"path": "$S/data/live/nhl_ingame_paper.jsonl", "max_gap_h": 30, "ts": "decided_at", "keys": ["gid", "event_ticker"], "active": {"season": "nhl"}}]},
    {"job": "nhl-om-a (NHL opener model)", "label": "quant-sports-nhl-om-a", "qs": "nhl-om-a",
     "outputs": [{"path": "$S/data/kx_forward/nhla.jsonl", "max_gap_h": 30, "ts": "logged_at", "keys": ["key", "trial"], "active": {"season": "nhl"}}],
     "picks": {"path": "$S/data/kx_forward/nhla.jsonl", "ts": "logged_at", "where": {"kind": "pick"}, "keys": ["key", "gameId"], "zero_days": 2, "active": {"season": "nhl"}}},
    {"job": "ot1 (crypto tails)", "label": "quant-sports-ot1", "qs": "ot1",
     "heartbeat": {"path": "$S/state/ot1_heartbeat", "max_gap_h": 0.1},
     "outputs": [{"path": "$S/data/kx_forward/ot1.jsonl", "max_gap_h": 30, "ts": "decided_at", "where": {"kind": "day"}, "keys": ["date", "status"]}],
     "picks": {"path": "$S/data/kx_forward/ot1.jsonl", "ts": "decided_at", "where": {"kind": "day"}, "zero_days": 1, "what": "decided days"}},
    {"job": "props (Kalshi prop ladders)", "label": "quant-sports-props", "qs": "props",
     "outputs": [{"path": "$S/data/kalshi_prop_log.jsonl", "max_gap_h": 30, "ts": "ts", "keys": ["ticker", "event_id"], "active": {"season": "nba"}},
                 {"path": "$S/data/kalshi_prop_grades.jsonl", "max_gap_h": 30, "active": {"season": "nba"}}]},
    {"job": "q017 (ERCOT peak)", "label": "quant-sports-q017", "qs": "q017",
     "outputs": [{"path": "$S/data/q017/fwd/quotes.jsonl", "max_gap_h": 1.5, "ts": "ts", "keys": ["ticker", "yes_bid"]}]},
    {"job": "quake-monthly (QM1/QM2)", "label": "quant-sports-quake-monthly", "qs": "quake-monthly",
     "heartbeat": {"path": "$S/state/quake_monthly_heartbeat", "max_gap_h": 1},
     "outputs": [{"path": "$S/data/kx_forward/quake_monthly_snaps.jsonl", "max_gap_h": 26, "ts": "t", "keys": ["events"]}]},
    {"job": "series-watch", "label": "quant-sports-series-watch", "qs": "series-watch",
     "outputs": [{"glob": "$S/digests/series_watch-*.md", "max_gap_h": 26}]},
    {"job": "snow-markets (TG1/SD1/SD2)", "label": "quant-sports-snow-markets", "qs": "snow-markets",
     "outputs": [{"path": "$S/results/snow_markets/snow_log.jsonl", "max_gap_h": 26, "ts": "ts", "keys": ["rule", "ticker"], "active": {"until": "2027-04-02T00:00:00+00:00"}}]},
    {"job": "state-gas-books", "label": "quant-sports-state-gas-books", "qs": "state-gas-books",
     "outputs": [{"path": "$S/data/kx_forward/state_gas_books.jsonl.gz", "max_gap_h": 14, "ts": "ts", "keys": ["state", "ticker"]}]},
    {"job": "ticket (daily ticket)", "label": "quant-sports-ticket", "qs": "ticket",
     "outputs": [{"glob": "$S/data/tickets/*.md", "max_gap_h": 26}]},
    {"job": "tsa (E1X-T paper)", "label": "quant-sports-tsa", "qs": "tsa",
     "outputs": [{"path": "$S/data/e1x/tsa_paper.jsonl", "max_gap_h": 192}]},
    {"job": "health-monitor (this job)", "label": "quant-sports-health", "logs": ["$S/logs/health.log"], "stderr": ["$S/logs/launchd-health.out"]}
  ]
}
